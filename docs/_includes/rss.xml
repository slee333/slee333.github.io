{%- comment -%}
  One RSS feed per language. Usage from a feed page:
  {% include rss.xml lang="kr" %}  (kr, en or es)
  Summaries prefer front matter description, then subtitle, then the excerpt.
{%- endcomment -%}
{%- assign feed_lang = include.lang -%}
{%- assign feed_text = site.data.phrases[feed_lang] -%}
{%- assign feed_prefix = '' -%}
{%- unless feed_lang == 'kr' -%}{%- assign feed_prefix = '/' | append: feed_lang -%}{%- endunless -%}
{%- assign feed_language = 'ko-KR' -%}
{%- if feed_lang == 'en' -%}{%- assign feed_language = 'en-US' -%}{%- elsif feed_lang == 'es' -%}{%- assign feed_language = 'es-ES' -%}{%- endif -%}
{%- assign feed_posts = site.posts | where: 'lang', feed_lang -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ feed_text.description | default: site.description | xml_escape }}</description>
    <link>{{ site.url }}{{ feed_prefix }}/</link>
    <language>{{ feed_language }}</language>
    <atom:link href="{{ site.url }}{{ feed_prefix }}/feed.xml" rel="self" type="application/rss+xml" />
    <lastBuildDate>{% for post in feed_posts limit:1 %}{{ post.date | date_to_rfc822 }}{% endfor %}</lastBuildDate>
    {%- for post in feed_posts limit:10 %}
    {%- assign summary = post.description | default: post.subtitle %}
    {%- if summary == nil or summary == '' %}{% assign summary = post.excerpt | strip_html | strip_newlines | truncate: 300 %}{% endif %}
    <item>
      <title>{{ post.title | xml_escape }}</title>
      <description>{{ summary | xml_escape }}</description>
      <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
    </item>
    {%- endfor %}
  </channel>
</rss>
